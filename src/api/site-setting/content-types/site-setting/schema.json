{
  "kind": "singleType",
  "collectionName": "site_settings",
  "info": {
    "singularName": "site-setting",
    "pluralName": "site-settings",
    "displayName": "Site Settings",
    "description": "Global site settings, branding, contacts and social links"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "siteName": {
      "type": "string"
    },
    "siteDescription": {
      "type": "text"
    },
    "favicon": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "defaultSeo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    },
    "contacts": {
      "type": "component",
      "repeatable": false,
      "component": "shared.contacts"
    },
    "socialLinks": {
      "type": "component",
      "repeatable": true,
      "component": "shared.social-link"
    },
    "deliveryDateSpb": {
      "type": "component",
      "repeatable": false,
      "component": "shared.delivery-date-range"
    },
    "deliveryDateMsk": {
      "type": "component",
      "repeatable": false,
      "component": "shared.delivery-date-range"
    },
    "deliveryTimeIntervalsSpb": {
      "type": "component",
      "repeatable": true,
      "component": "shared.delivery-time-interval"
    },
    "deliveryTimeIntervalsMsk": {
      "type": "component",
      "repeatable": true,
      "component": "shared.delivery-time-interval"
    },
    "promoText": {
      "type": "text"
    }
  }
}
